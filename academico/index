<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Psicoterapia Breve — Dra. Lucia Kratz</title>
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --roxo:#7B00C4;--roxo-dark:#5a0090;--roxo-light:#f3e8ff;--roxo-mid:#ede9fe;
  --text:#1f2937;--text-light:#6b7280;--border:#e5e7eb;--white:#fff;
  --green:#16a34a;--red:#dc2626;--amber:#d97706;--blue:#2563eb;
}
body{font-family:'Inter',sans-serif;background:linear-gradient(135deg,#f3e8ff 0%,#faf5ff 50%,#ede9fe 100%);min-height:100vh;color:var(--text)}

/* ===== LOGIN ===== */
.login-wrap{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px}
.login-card{background:var(--white);border-radius:24px;padding:40px;width:100%;max-width:460px;box-shadow:0 8px 48px rgba(123,0,196,.14)}
.logo-name{font-family:'Dancing Script',cursive;font-size:34px;color:var(--roxo);font-weight:700;text-align:center}
.logo-sub{font-size:12px;color:var(--text-light);text-align:center;margin-top:2px;margin-bottom:8px}
.login-title{font-size:18px;font-weight:700;color:#3d006a;text-align:center;margin:18px 0 4px}
.login-sub{font-size:13px;color:var(--text-light);text-align:center;margin-bottom:28px;line-height:1.6}
.fg{margin-bottom:16px;position:relative}
label.lbl{display:block;font-size:11px;font-weight:700;color:var(--text-light);text-transform:uppercase;letter-spacing:.6px;margin-bottom:6px}
input.inp{width:100%;padding:12px 14px;border:1.5px solid var(--border);border-radius:10px;font-size:14px;font-family:'Inter',sans-serif;color:var(--text);outline:none;transition:border-color .2s}
input.inp:focus{border-color:var(--roxo)}
.autocomplete-list{position:absolute;top:100%;left:0;right:0;background:var(--white);border:1.5px solid var(--roxo);border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.1);z-index:100;max-height:200px;overflow-y:auto;margin-top:4px}
.autocomplete-item{padding:10px 14px;cursor:pointer;font-size:14px;color:var(--text);transition:background .15s}
.autocomplete-item:hover{background:var(--roxo-light)}
.btn-primary{width:100%;padding:14px;background:var(--roxo);color:var(--white);border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif;margin-top:8px;transition:opacity .2s}
.btn-primary:hover{opacity:.88}
.btn-primary:disabled{opacity:.5;cursor:default}
.erro-box{background:#fee2e2;color:var(--red);border-radius:8px;padding:10px 14px;font-size:13px;margin-bottom:14px;font-weight:500}
.badge-prof{display:inline-block;background:#7B00C4;color:#fff;font-size:10px;font-weight:700;border-radius:20px;padding:2px 10px;letter-spacing:.5px;margin-left:8px;vertical-align:middle}

/* ===== APP SHELL ===== */
.app{display:flex;min-height:100vh}
.sidebar{width:240px;background:#3d006a;color:#fff;display:flex;flex-direction:column;flex-shrink:0;position:fixed;top:0;bottom:0;left:0;z-index:50;overflow-y:auto}
.sidebar-logo{padding:24px 20px 16px;border-bottom:1px solid rgba(255,255,255,.1)}
.sidebar-logo .logo-name{font-size:22px;color:#e9d5ff;text-align:left}
.sidebar-logo .logo-sub{font-size:10px;color:rgba(255,255,255,.55);text-align:left}
.sidebar-user{padding:12px 20px;font-size:12px;color:rgba(255,255,255,.7);border-bottom:1px solid rgba(255,255,255,.08)}
.sidebar-user strong{color:#fff;display:block;font-size:13px}
nav.sidebar-nav{padding:12px 0;flex:1}
.nav-item{display:flex;align-items:center;gap:10px;padding:11px 20px;font-size:14px;font-weight:500;color:rgba(255,255,255,.75);cursor:pointer;transition:background .15s;border-left:3px solid transparent}
.nav-item:hover{background:rgba(255,255,255,.08);color:#fff}
.nav-item.active{background:rgba(255,255,255,.12);color:#fff;border-left-color:#c084fc}
.nav-item .icon{font-size:16px;width:20px;text-align:center}
.sidebar-footer{padding:16px 20px;border-top:1px solid rgba(255,255,255,.1)}
.btn-logout{width:100%;padding:9px;background:rgba(255,255,255,.1);color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;transition:background .2s}
.btn-logout:hover{background:rgba(255,255,255,.2)}
.main{margin-left:240px;flex:1;padding:32px;min-height:100vh;background:transparent}

/* ===== CARDS / LAYOUT ===== */
.page-title{font-size:22px;font-weight:700;color:#3d006a;margin-bottom:4px}
.page-sub{font-size:13px;color:var(--text-light);margin-bottom:24px}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
.card{background:var(--white);border-radius:16px;padding:24px;box-shadow:0 2px 16px rgba(123,0,196,.07)}
.card-title{font-size:14px;font-weight:700;color:#3d006a;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.stat-val{font-size:32px;font-weight:800;color:var(--roxo)}
.stat-lbl{font-size:12px;color:var(--text-light);margin-top:2px}
.divider{border:none;border-top:1px solid var(--border);margin:20px 0}

/* ===== BUTTONS ===== */
.btn{padding:9px 18px;border-radius:9px;font-size:13px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;border:none;transition:opacity .2s}
.btn:hover{opacity:.85}
.btn-sm{padding:6px 12px;font-size:12px;border-radius:7px}
.btn-roxo{background:var(--roxo);color:#fff}
.btn-outline{background:transparent;border:1.5px solid var(--roxo);color:var(--roxo)}
.btn-green{background:#16a34a;color:#fff}
.btn-red{background:#dc2626;color:#fff}
.btn-gray{background:#f3f4f6;color:var(--text);border:1px solid var(--border)}
.btn-row{display:flex;gap:8px;flex-wrap:wrap}

/* ===== TABLE ===== */
.tbl-wrap{overflow-x:auto;border-radius:12px;border:1px solid var(--border)}
table{width:100%;border-collapse:collapse;font-size:13px}
th{background:#f9fafb;padding:10px 14px;text-align:left;font-size:11px;font-weight:700;color:var(--text-light);text-transform:uppercase;letter-spacing:.4px;border-bottom:1px solid var(--border)}
td{padding:10px 14px;border-bottom:1px solid #f3f4f6;color:var(--text)}
tr:last-child td{border-bottom:none}
tr:hover td{background:#faf5ff}

/* ===== BADGES ===== */
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}
.badge-ok{background:#dcfce7;color:#16a34a}
.badge-pend{background:#fef3c7;color:#92400e}
.badge-no{background:#fee2e2;color:#dc2626}
.badge-roxo{background:#f3e8ff;color:#7B00C4}
.badge-blue{background:#dbeafe;color:#1d4ed8}

/* ===== FORM ELEMENTS ===== */
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.form-group{margin-bottom:14px}
.form-group label{display:block;font-size:11px;font-weight:700;color:var(--text-light);text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:10px 13px;border:1.5px solid var(--border);border-radius:9px;font-size:13px;font-family:'Inter',sans-serif;color:var(--text);outline:none;transition:border-color .2s}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--roxo)}
.form-group textarea{resize:vertical;min-height:80px}

/* ===== CASO CARD ===== */
.caso-card{background:var(--white);border-radius:14px;border:1.5px solid var(--border);padding:20px;margin-bottom:14px;transition:border-color .2s}
.caso-card:hover{border-color:#c084fc}
.caso-header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:10px}
.caso-num{background:var(--roxo);color:#fff;border-radius:8px;padding:4px 10px;font-size:11px;font-weight:700}
.caso-nome{font-size:15px;font-weight:700;color:#3d006a}
.caso-ctx{font-size:12px;color:var(--text-light);margin-bottom:8px}
.caso-segredo{background:#fee2e2;border:1px solid #fca5a5;border-radius:8px;padding:10px 14px;font-size:12px;color:#991b1b;margin-top:10px}
.caso-body{font-size:13px;color:var(--text);line-height:1.6}
.caso-section{margin-top:10px}
.caso-section-title{font-size:11px;font-weight:700;color:var(--text-light);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
.toggle-btn{background:none;border:none;cursor:pointer;font-size:12px;color:var(--roxo);font-weight:600;padding:0;font-family:'Inter',sans-serif}

/* ===== AVALIAÇÃO ===== */
.eval-form{background:#f9fafb;border-radius:12px;padding:20px;margin-top:16px}
.rating-row{display:flex;gap:10px;margin-bottom:16px}
.rating-opt{flex:1;border:2px solid var(--border);border-radius:10px;padding:12px;text-align:center;cursor:pointer;transition:all .15s;font-size:13px}
.rating-opt:hover{border-color:var(--roxo);background:var(--roxo-light)}
.rating-opt.selected{border-color:var(--roxo);background:var(--roxo-light);font-weight:700}
.stars{font-size:20px}

/* ===== NOTA ===== */
.nota-display{font-size:28px;font-weight:800;color:var(--roxo)}
.nota-max{font-size:14px;color:var(--text-light);font-weight:400}
.progress-bar{height:8px;background:#e5e7eb;border-radius:10px;overflow:hidden;margin-top:6px}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--roxo),#c084fc);border-radius:10px;transition:width .4s}

/* ===== ALERT ===== */
.alert{border-radius:10px;padding:12px 16px;font-size:13px;margin-bottom:16px;display:flex;align-items:flex-start;gap:10px;line-height:1.5}
.alert-warn{background:#fffbeb;border:1px solid #fde68a;color:#92400e}
.alert-info{background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af}
.alert-icon{font-size:16px;flex-shrink:0;margin-top:1px}

/* ===== FICHA N1 ===== */
.ficha-field{margin-bottom:16px}
.ficha-field label{font-size:12px;font-weight:700;color:#3d006a;margin-bottom:6px;display:block}
.ficha-field textarea{width:100%;border:1.5px solid var(--border);border-radius:9px;padding:10px 13px;font-size:13px;font-family:'Inter',sans-serif;outline:none;resize:vertical;min-height:70px;transition:border-color .2s}
.ficha-field textarea:focus{border-color:var(--roxo)}

/* ===== DISPARO ===== */
.disparo-card{border:2px dashed #c084fc;border-radius:14px;padding:24px;text-align:center;margin-bottom:20px}
.disparo-icon{font-size:40px;margin-bottom:8px}
.disparo-title{font-size:16px;font-weight:700;color:#3d006a;margin-bottom:4px}
.disparo-sub{font-size:13px;color:var(--text-light)}

/* ===== MOBILE ===== */
@media(max-width:768px){
  .sidebar{width:100%;height:auto;position:relative;flex-direction:row;flex-wrap:wrap}
  .main{margin-left:0;padding:16px}
  .app{flex-direction:column}
  .grid-2,.grid-3{grid-template-columns:1fr}
  .form-row{grid-template-columns:1fr}
  .rating-row{flex-direction:column}
}

/* ===== HIDDEN ===== */
.hidden{display:none!important}
.section{display:none}
.section.active{display:block}

/* ===== INPUT SEARCH ===== */
.search-input{padding:9px 13px;border:1.5px solid var(--border);border-radius:9px;font-size:13px;font-family:'Inter',sans-serif;outline:none;transition:border-color .2s;width:260px}
.search-input:focus{border-color:var(--roxo)}

/* ===== NOTA INPUT ===== */
.nota-inp{width:80px;padding:7px 10px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-family:'Inter',sans-serif;text-align:center;outline:none}
.nota-inp:focus{border-color:var(--roxo)}

/* ===== TAG ===== */
.tag{display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:600;margin-right:4px}
</style>
</head>
<body>

<!-- ===== SELEÇÃO DE PERFIL ===== -->
