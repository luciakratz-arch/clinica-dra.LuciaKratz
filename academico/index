async function carregarDisparos(){
  try{
    const snap = await db.collection('acad_disparos').orderBy && 
      db.collection('acad_disparos').get();
    if(snap){ 
      disparos = snap.docs.map(d => ({id:d.id,...d.data()}));
      disparos.sort((a,b)=> (b.criadoEm?.seconds||0)-(a.criadoEm?.seconds||0));
    }
  }catch(e){ disparos = []; }
  renderizarDisparos();
}

async function disparar(){
  const data = document.getElementById('disp-data').value;
  const tipo = document.getElementById('disp-tipo').value;
  const grupo = document.getElementById('disp-grupo').value.trim();
  const casoVal = document.getElementById('disp-caso').value;
