function irPara(sec){
  secaoAtual = sec;
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  const el = document.getElementById('sec-'+sec);
  if(el) el.classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const navEl = document.querySelector(`.nav-item[onclick="irPara('${sec}')"]`);
  if(navEl) navEl.classList.add('active');

  // lazy load
  if(sec==='adm-casos') renderizarCasos();
  if(sec==='adm-pauta') renderizarPauta();
  if(sec==='adm-alunos') renderizarTabelaAlunos();
  if(sec==='adm-disparo') carregarDisparos();
