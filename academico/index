  if(!data||!grupo||!casoVal){ alert('Preencha data, grupo e caso antes de disparar.'); return; }

  const novo = {data, tipo, grupo, caso:casoTxt, respostas:0, criadoEm: firebase.firestore.FieldValue.serverTimestamp()};
  try{
    const ref = await db.collection('acad_disparos').add(novo);
    disparos.unshift({...novo, id:ref.id});
    document.getElementById('adm-total-disparos').textContent = disparos.length;
    renderizarDisparos();
    alert('✅ Atividade disparada para a turma!');
  }catch(e){ alert('Erro ao disparar. Tente novamente.'); }
}

