  document.getElementById('painel-n2').textContent = n2.toFixed(1);
  document.getElementById('painel-media').textContent = media;
  document.getElementById('prog-n1').style.width = (n1*10)+'%';
  document.getElementById('prog-n2').style.width = (n2*10)+'%';
  document.getElementById('prog-media').style.width = (parseFloat(media)*10)+'%';

  const pendEl = document.getElementById('painel-atividades');
  pendEl.innerHTML = '<span style="color:var(--green);font-weight:600">✅ Nenhuma atividade pendente no momento.</span>';
}

function calcPlateia(aluno){
  const fichas = (aluno.fichasPlateia || []).length;
  const totalDisp = disparos.filter(d => d.tipo==='microaval').length;
  if(totalDisp === 0) return 0;
  return Math.min(2.0, (fichas / totalDisp) * 2.0);
}

