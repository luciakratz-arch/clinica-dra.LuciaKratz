function abrirWhatsApp(tipo){
  const base = window.location.href.split('?')[0];
  const url = encodeURIComponent(tipo==='grupos'?base+'?acao=grupos':base+'?acao=historico');
  const msg = tipo==='grupos'
    ? encodeURIComponent('📋 *Psicoterapia Breve — Formação de Grupos*\nAcesse o link abaixo para cadastrar os integrantes do seu grupo:\n')
    : encodeURIComponent('📊 *Psicoterapia Breve — Consulta de Notas*\nAcesse o link abaixo para ver seu histórico individual:\n');
  window.open(`https://api.whatsapp.com/send?text=${msg}${url}`, '_blank');
}

