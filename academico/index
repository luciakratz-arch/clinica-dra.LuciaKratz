  // Busca aluno local (mock) ou no Firebase
  let aluno = todosAlunos.find(a => a.nome.toLowerCase() === nome.toLowerCase() && a.matricula === mat);

  if(!aluno){
    // tenta firebase
    try{
      const snap = await db.collection('acad_alunos').where('matricula','==',mat).get();
