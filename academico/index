      </button>



    </div>
    <div style="text-align:center;margin-top:24px;font-size:12px;color:#9ca3af">
      Plataforma protegida · Dra. Lucia Kratz · CRP 09/20590<br/>
      <a href="../" style="color:#7B00C4;text-decoration:none;font-weight:500">← Voltar ao site</a>
    </div>
  </div>
</div>

<!-- ===== LOGIN SUPERVISÃO ===== -->
<div id="supervisao-view" class="login-wrap hidden">
  <div class="login-card">
    <button onclick="voltarSelecao()" style="background:none;border:none;cursor:pointer;font-size:13px;color:#6b7280;font-family:'Inter',sans-serif;margin-bottom:20px;padding:0;display:flex;align-items:center;gap:6px">← Voltar</button>
