let pautaFiltrada = [];
function renderizarPauta(){
  pautaFiltrada = [...todosAlunos];
  renderizarLinhasPauta(pautaFiltrada);
}
function filtrarPauta(val){
  const lower = val.toLowerCase();
  const fil = todosAlunos.filter(a => a.nome.toLowerCase().includes(lower) || a.matricula.includes(lower));
  renderizarLinhasPauta(fil);
}
function renderizarLinhasPauta(lista){
  const tbody = document.getElementById('tbl-pauta');
  if(!tbody) return;
  tbody.innerHTML = lista.map(a => {
    const n1 = a.notaN1 || 0;
    const sem = a.notaSeminario || 0;
    const esa = a.notaESA || 0;
    const plat = calcPlateia(a);
    const n2 = Math.min(10, sem+plat+esa);
    const media = ((n1+n2)/2);
    const aprov = media >= 6;
    return `<tr>
      <td><span class="badge badge-roxo">${a.matricula}</span></td>
      <td style="font-weight:600">${a.nome}</td>
      <td style="font-size:12px">${a.grupoN1||'—'}</td>
      <td style="font-weight:600;color:${n1>=6?'var(--green)':'var(--red)'}">${n1.toFixed(1)}</td>
      <td style="font-size:12px">${a.grupoN2||'—'}</td>
      <td>${sem.toFixed(1)}</td>
      <td>${plat.toFixed(1)}</td>
      <td>${esa.toFixed(1)}</td>
      <td style="font-weight:600;color:${n2>=6?'var(--green)':'var(--red)'}">${n2.toFixed(1)}</td>
      <td style="font-size:18px;font-weight:800;color:${aprov?'var(--green)':'var(--red)'}">${media.toFixed(1)}</td>
      <td><span class="badge ${aprov?'badge-ok':'badge-no'}">${aprov?'Aprovado':'Em risco'}</span></td>
    </tr>`;
  }).join('');
}

function exportarPauta(){
  const header = 'Matrícula,Nome,Grupo N1,N1,Grupo N2,Seminário,Plateia,ESA,Total N2,Média\n';
  const rows = todosAlunos.map(a => {
    const n1=a.notaN1||0, sem=a.notaSeminario||0, esa=a.notaESA||0, plat=calcPlateia(a);
    const n2=Math.min(10,sem+plat+esa), media=((n1+n2)/2).toFixed(1);
    return `${a.matricula},${a.nome},${a.grupoN1||''},${n1},${a.grupoN2||''},${sem},${plat.toFixed(1)},${esa},${n2.toFixed(1)},${media}`;
  }).join('\n');
  const blob = new Blob([header+rows], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download='pauta_psicoterapia_breve.csv'; a.click();
}

